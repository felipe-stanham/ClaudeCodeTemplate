#!/bin/sh
# Refuses commits that stage secrets (.env, .deploy-secrets, docs/local/).
# Backstop for the Claude Code secrets hook; also covers commits made outside Claude.
# Installed by template-sync via `git config core.hooksPath .githooks`.
STAGED=$(git diff --cached --name-only | grep -E '(^|/)\.env$|(^|/)\.deploy-secrets$|^docs/local/')
if [ -n "$STAGED" ]; then
  echo "pre-commit: refusing to commit secrets:" >&2
  echo "$STAGED" | sed 's/^/  /' >&2
  echo "Unstage with: git restore --staged <file>, and make sure they are in .gitignore." >&2
  exit 1
fi
exit 0
